# apps/admin environment. Copy to `.env.local` for dev. On the server this is
# /apps/mehdisafarzade.dev/frontend/.env.admin (written by you, never committed).

# Public API base (shared package requirement). The admin browser code does NOT call it
# directly; it uses the same-origin /api proxy. Needed only because @portfolio/config validates it.
#   dev:  http://localhost:3100/v1
#   prod: https://api.mehdisafarzade.dev/v1
NEXT_PUBLIC_API_URL=

# The admin origin as the browser sees it (behind the device gate).
#   dev (local gate container): https://admin.localhost:8443
#   prod: https://admin.mehdisafarzade.dev
NEXT_PUBLIC_ADMIN_URL=

# Public site origin, for "view on site" / preview links.
#   dev:  http://localhost:5600
#   prod: https://www.mehdisafarzade.dev
NEXT_PUBLIC_SITE_URL=

# Server-only: API base for server components, forwarding the cookie + X-Admin-Device they received.
#   dev:  http://localhost:3100/v1
#   prod: http://portfolio-api:3000/v1
INTERNAL_API_URL=
