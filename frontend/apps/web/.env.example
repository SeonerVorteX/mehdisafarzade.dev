# apps/web environment. Copy to `.env.local` for dev. On the server this is
# /apps/mehdisafarzade.dev/frontend/.env.web (written by you, never committed).
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time.

# Public API base URL including the version prefix.
#   dev:  http://localhost:3100/v1
#   prod: https://api.mehdisafarzade.dev/v1
NEXT_PUBLIC_API_URL=

# Canonical site origin, no trailing slash. Used for metadataBase, canonical URLs, sitemap, OG.
#   dev:  http://localhost:5600
#   prod: https://www.mehdisafarzade.dev
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile site key (public). Leave empty in dev to use Cloudflare's
# always-pass test key 1x00000000000000000000AA, or set that value explicitly.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics beacon token. Production only; leave empty in dev.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Server-only (runtime, not inlined): Docker-network API base for SSR fetches.
#   dev:  leave empty (SSR uses NEXT_PUBLIC_API_URL)
#   prod: http://portfolio-api:3000/v1
INTERNAL_API_URL=

# Server-only: shared HMAC secret for POST /api/revalidate (API → web). Phase 4.
# Generate with: openssl rand -base64 48
REVALIDATE_SECRET=

# Server-only: HMAC secret for draft-mode preview links (admin → web) and web → API preview fetches. Phase 7.
PREVIEW_SECRET=
