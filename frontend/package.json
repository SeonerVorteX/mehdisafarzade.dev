{
  "name": "portfolio-frontend",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "i18n:check": "node packages/i18n/scripts/check.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,scss,md}\"",
    "ci": "yarn typecheck && yarn lint && yarn test && yarn i18n:check"
  },
  "devDependencies": {
    "@playwright/test": "~1.62.0",
    "@tailwindcss/postcss": "^4.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "eslint-config-prettier": "^10",
    "postcss": "^8.5",
    "prettier": "^3",
    "sass": "^1.92",
    "tailwindcss": "^4.1",
    "turbo": "^2.9.16",
    "typescript": "^5.9",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
