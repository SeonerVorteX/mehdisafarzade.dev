# dependencies
node_modules/
.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/sdks
!**/.yarn/versions

# build output
.next/
out/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo
next-env.d.ts

# env files: never commit real values (.env.example is the documented template)
.env
.env.*
!.env.example
!**/.env.example

# secrets / certificates
*.pem
*.key
*.crt
*.p12
certs/

# device gate: tokens live only on the server (or the local gate volume)
*.map
!*.map.example
*.unlock
deploy/device-gate/.local/
deploy/device-gate/local/

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# test output
test-results/
playwright-report/
playwright/.cache/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.vercel

# legacy local-only leftovers (untracked on GitHub too)
legacy/TODO.md
legacy/package-lock.json

# local device-gate dev container (deploy/nginx/dev): self-signed cert + local maps
deploy/nginx/dev/.certs/
deploy/nginx/dev/.gate/
