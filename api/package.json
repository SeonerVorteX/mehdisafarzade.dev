{
    "name": "portfolio-api",
    "version": "0.1.0",
    "description": "API service of mehdisafarzade.dev",
    "author": "Mehdi Safarzade <contact@mehdisafarzade.dev>",
    "private": true,
    "license": "Apache-2.0",
    "packageManager": "yarn@4.12.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "nest build",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
        "lint:fix": "eslint \"{src,test,prisma}/**/*.ts\" --fix",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
        "start": "dotenv -e .env.dev -- nest start",
        "start:dev": "yarn prestart:dev && dotenv -e .env.dev -- nest start --watch",
        "start:debug": "dotenv -e .env.dev -- nest start --debug --watch",
        "start:prod": "node dist/main.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:e2e": "yarn pretest:e2e && dotenv -e .env.test -- jest --config ./test/jest-e2e.json --runInBand --detectOpenHandles; code=$?; yarn posttest:e2e; exit $code",
        "pretest:e2e": "echo 'no e2e services needed yet'",
        "posttest:e2e": "echo 'done'",
        "prestart:dev": "echo 'no dev services needed yet'",
        "ci": "yarn typecheck && yarn lint && yarn test && yarn test:e2e"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "moduleNameMapper": {
            "^src/(.*)$": "<rootDir>/$1"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "dependencies": {
        "@nestjs/common": "^11",
        "@nestjs/core": "^11",
        "@nestjs/platform-express": "^11",
        "express": "^5",
        "reflect-metadata": "^0.2",
        "rxjs": "^7.8"
    },
    "devDependencies": {
        "@nestjs/cli": "^11",
        "@nestjs/schematics": "^11",
        "@nestjs/testing": "^11",
        "@types/express": "^5",
        "@types/jest": "^29",
        "@types/node": "^22",
        "@types/source-map-support": "^0",
        "@types/supertest": "^6",
        "dotenv-cli": "^8",
        "eslint": "^9",
        "eslint-config-prettier": "^10",
        "eslint-plugin-prettier": "^5",
        "globals": "^17.12.0",
        "jest": "^29",
        "prettier": "^3",
        "source-map-support": "^0.5.21",
        "supertest": "^7",
        "ts-jest": "^29",
        "ts-node": "^10",
        "tsconfig-paths": "^4",
        "typescript": "~5.9",
        "typescript-eslint": "^8"
    }
}
