{
    "name": "portfolio-api",
    "version": "0.1.0",
    "description": "API service of mehdisafarzade.dev",
    "author": "Mehdi Safarzade <contact@mehdisafarzade.dev>",
    "private": true,
    "license": "Apache-2.0",
    "packageManager": "yarn@4.12.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "nest build",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
        "lint:fix": "eslint \"{src,test,prisma}/**/*.ts\" --fix",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
        "start": "dotenv -e .env.dev -- nest start",
        "start:dev": "yarn prestart:dev && dotenv -e .env.dev -- nest start --watch",
        "start:debug": "dotenv -e .env.dev -- nest start --debug --watch",
        "start:prod": "node dist/main.js",
        "services:dev:up": "docker compose -f docker-compose.dev.yml up -d --wait db-dev redis-dev rabbitmq-dev s3-dev mailpit-dev",
        "services:dev:stop": "docker compose -f docker-compose.dev.yml stop",
        "db:dev:up": "docker compose -f docker-compose.dev.yml up -d --wait db-dev",
        "db:dev:rm": "docker compose -f docker-compose.dev.yml rm -s -f -v db-dev",
        "db:test:up": "docker compose -f docker-compose.dev.yml up -d --wait db-test",
        "db:test:rm": "docker compose -f docker-compose.dev.yml rm -s -f -v db-test",
        "redis:dev:up": "docker compose -f docker-compose.dev.yml up -d --wait redis-dev",
        "rabbitmq:dev:up": "docker compose -f docker-compose.dev.yml up -d --wait rabbitmq-dev",
        "rabbitmq:test:vhost": "docker exec portfolio-rabbitmq-dev sh -c \"rabbitmqctl -q add_vhost portfolio_test 2>/dev/null; rabbitmqctl -q set_permissions -p portfolio_test portfolio '.*' '.*' '.*'\"",
        "prisma:generate": "prisma generate",
        "prisma:dev:migrate": "dotenv -e .env.dev -- prisma migrate dev",
        "prisma:dev:deploy": "dotenv -e .env.dev -- prisma migrate deploy",
        "prisma:dev:studio": "dotenv -e .env.dev -- prisma studio",
        "prisma:dev:clear": "dotenv -e .env.dev -- prisma migrate reset",
        "prisma:dev:seed": "dotenv -e .env.dev -- prisma db seed",
        "prisma:test:deploy": "dotenv -e .env.test -e test/e2e.env -- prisma migrate deploy",
        "prestart:dev": "yarn services:dev:up && yarn prisma:dev:deploy",
        "pretest:e2e": "docker compose -f docker-compose.dev.yml up -d --wait db-test redis-dev rabbitmq-dev s3-dev && yarn rabbitmq:test:vhost && yarn prisma:test:deploy",
        "posttest:e2e": "yarn db:test:rm",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:e2e": "yarn pretest:e2e && dotenv -e .env.test -e test/e2e.env -- jest --config ./test/jest-e2e.json --runInBand --detectOpenHandles; code=$?; yarn posttest:e2e; exit $code",
        "ci": "yarn typecheck && yarn lint && yarn test && yarn test:e2e"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "moduleNameMapper": {
            "^src/(.*)$": "<rootDir>/$1"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3",
        "@aws-sdk/s3-request-presigner": "^3",
        "@nest-lab/throttler-storage-redis": "^1",
        "@nestjs-modules/mailer": "^2",
        "@nestjs/common": "^11",
        "@nestjs/core": "^11",
        "@nestjs/jwt": "^11",
        "@nestjs/microservices": "^11",
        "@nestjs/passport": "^11",
        "@nestjs/platform-express": "^11",
        "@nestjs/schedule": "^6",
        "@nestjs/swagger": "^11",
        "@nestjs/throttler": "^6",
        "@prisma/client": "^6",
        "amqp-connection-manager": "^4",
        "amqplib": "^0.10",
        "argon2": "^0.40",
        "class-transformer": "^0.5",
        "class-validator": "^0.14",
        "cookie-parser": "^1.4",
        "express": "^5",
        "handlebars": "^4.7",
        "helmet": "^8",
        "ioredis": "^6",
        "nest-winston": "^1.10",
        "nestjs-i18n": "^10",
        "nodemailer": "^7",
        "otplib": "^12",
        "passport": "^0.7",
        "passport-jwt": "^4",
        "reflect-metadata": "^0.2",
        "rxjs": "^7.8",
        "sharp": "^0.34",
        "winston": "^3.17",
        "winston-daily-rotate-file": "^5"
    },
    "devDependencies": {
        "@nestjs/cli": "^11",
        "@nestjs/schematics": "^11",
        "@nestjs/testing": "^11",
        "@types/amqplib": "^0.10.8",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5",
        "@types/jest": "^29",
        "@types/node": "^22",
        "@types/nodemailer": "^8.0.2",
        "@types/passport": "^0",
        "@types/passport-jwt": "^4",
        "@types/source-map-support": "^0",
        "@types/supertest": "^6",
        "dotenv-cli": "^8",
        "eslint": "^9",
        "eslint-config-prettier": "^10",
        "eslint-plugin-prettier": "^5",
        "globals": "^17.12.0",
        "jest": "^29",
        "prettier": "^3",
        "prisma": "^6",
        "source-map-support": "^0.5.21",
        "supertest": "^7",
        "ts-jest": "^29",
        "ts-node": "^10",
        "tsconfig-paths": "^4",
        "typescript": "~5.9",
        "typescript-eslint": "^8"
    },
    "prisma": {
        "seed": "ts-node --transpile-only prisma/seed.ts"
    }
}
