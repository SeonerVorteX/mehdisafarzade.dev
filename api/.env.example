# api environment. Copy to `.env.dev` (dev) and `.env.test` (e2e); on the server it is
# /apps/mehdisafarzade.dev/api/.env, written by the owner and never committed.
# Every variable is validated at boot by src/assertEnv.ts (Phase 2).

# development | test | production
NODE_ENV=development

# HTTP port inside the process/container (dev: 3100; container: 3000).
SERVER_PORT=3100
