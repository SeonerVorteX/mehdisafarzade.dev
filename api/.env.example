# ─────────────────────────────────────────────────────────────────────────────
# api environment. Copy to `.env.dev` for local development.
# On the server this is /apps/mehdisafarzade.dev/api/.env, written by the owner, never committed.
# Every value is validated at boot by src/assertEnv.ts; the app refuses to start if one is wrong.
# e2e tests use test/e2e.env (committed, throwaway values), overridable by a local .env.test.
#
# Generate secrets with:   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# TOTP_ENC_KEY must be exactly 32 random bytes, base64 (44 chars):
#                          node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
# Port the API listens on. dev: 3100 · container: 3000
SERVER_PORT=3100
# Log directory (daily-rotated JSON files) and level (error|warn|info|debug)
LOG_DIR=./logs
LOG_LEVEL=debug

# ── Data services ────────────────────────────────────────────────────────────
# Outside production these MUST point at localhost / portfolio-* containers (assertEnv enforces it).
# dev:  postgresql://portfolio:portfolio@localhost:5436/portfolio
# prod: postgresql://portfolio:<password>@db:5432/portfolio        (role `portfolio`, owns only this DB)
DATABASE_URL=
# The trailing /1 selects the Redis DB index. dev: redis://localhost:6382/1
# prod: redis://:<password>@redis:6379/1   (shared Redis → DB 1 + key prefix)
REDIS_URL=
# Prefix for every Redis key this app writes. Keep `pf:` in production.
REDIS_KEY_PREFIX=pf:
# dev:  amqp://portfolio:portfolio@localhost:5673/portfolio
# prod: amqp://portfolio:<password>@rabbitmq:5672/portfolio        (vhost `portfolio`)
RABBITMQ_URL=

# ── Origins ──────────────────────────────────────────────────────────────────
# Public site origin (CORS allowlist + links in emails). dev: http://localhost:5600 · prod: https://www.mehdisafarzade.dev
WEB_ORIGIN=
# Admin origin, as the browser sees it through the device gate (CSRF Origin check, OAuth redirect).
# dev (local gate): https://localhost:8443 · prod: https://admin.mehdisafarzade.dev
ADMIN_ORIGIN=
# Extra comma-separated CORS origins for the public site (e.g. the temporary https://v2.mehdisafarzade.dev at cutover).
CORS_EXTRA_ORIGINS=

# ── S3 (media library). Optional in dev (media endpoints return 503 without it); required in production.
# dev with SeaweedFS (portfolio-s3-dev): S3_ENDPOINT=http://localhost:9002, S3_FORCE_PATH_STYLE=true,
#   S3_ACCESS_KEY_ID=portfolio, S3_SECRET_ACCESS_KEY=portfolio-dev-secret, S3_BUCKET=portfolio-media-dev
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ── Email (Nodemailer). Optional in dev; required in production.
# dev with Mailpit (portfolio-mailpit-dev, UI http://localhost:8026): MAIL_HOST=localhost, MAIL_PORT=1026, no user/pass.
# prod (SES SMTP): MAIL_HOST=email-smtp.<region>.amazonaws.com, MAIL_PORT=587, SES SMTP credentials.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Mehdi Safarzade <no-reply@mehdisafarzade.dev>"
# Where contact-form notifications go.
CONTACT_NOTIFY_TO=contact@mehdisafarzade.dev

# Pepper for hashing visitor IPs (contact form); raw IPs are never stored. ≥32 chars. Required in production.
IP_HASH_PEPPER=

# ── Admin realm (Phase 3) ───────────────────────────────────────────────────
# Signs the 10-minute access JWT (__Host-pf_at). ≥32 chars.
ADMIN_JWT_SECRET=
# Signs the 5-minute "password OK, TOTP pending" token (__Host-pf_pending). Must differ from ADMIN_JWT_SECRET.
ADMIN_PENDING_JWT_SECRET=
# AES-256-GCM key that encrypts TOTP secrets at rest: 32 random bytes, base64 (44 chars).
# Rotating it makes existing TOTP enrollments unreadable (re-enroll), so keep it stable and backed up.
TOTP_ENC_KEY=

# Google sign-in for admins (optional; leave all three empty to disable the button).
# OAuth client of type "Web application". Redirect URI: <ADMIN_ORIGIN>/api/auth/google/callback
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
# Comma-separated emails allowed to use Google sign-in. Each must ALSO be an existing, active admin user.
ADMIN_GOOGLE_ALLOWLIST=

# ── Seed only (prisma/seed.ts); not read by the running API ──────────────────
# The first admin user. The seed creates it once, with no TOTP, so the first login forces enrollment.
SEED_ADMIN_EMAIL=
# ≥12 chars. Only used when the admin doesn't exist yet; changing it later has no effect.
SEED_ADMIN_PASSWORD=
