# Non-secret, e2e-only values for the disposable test services in docker-compose.dev.yml.
# Committed on purpose: these reach only localhost containers with throwaway data.
# A local .env.test (gitignored) takes precedence over this file via dotenv-cli ordering.
NODE_ENV=test
LOG_LEVEL=error
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5437/portfolio_test
REDIS_URL=redis://localhost:6382/2
REDIS_KEY_PREFIX=pf-test:
RABBITMQ_URL=amqp://portfolio:portfolio@localhost:5673/portfolio_test
WEB_ORIGIN=http://localhost:5600
ADMIN_ORIGIN=https://localhost:8443
ADMIN_JWT_SECRET=e2e-only-WkmvU7LFamHNKKlPXSLPWgFStaF5EFPnuvDbZRPbzsbCTug6
ADMIN_PENDING_JWT_SECRET=e2e-only-b3UQ9gVZQO1LSC0zY6fceaVV+QWIagc/ZpNsni5BXgNbtwpq
TOTP_ENC_KEY=xLykgbE4UOAm0gdzvEXsQ6tOCWwepzDEU5Bscv//lLw=
IP_HASH_PEPPER=e2e-only-BNrRrx3B0qdhQX4wc6Azg3JfIMNDZPZlA7fQ0zyNyiQBqn9U
# supertest connects over loopback; admin-trust.e2e-spec overrides this per file
ADMIN_TRUSTED_SOURCES=127.0.0.1,::1
