# /etc/nginx/device-gate/admin.mehdisafarzade.dev.unlock  (root:root 0600, NEVER committed)
# Empty except for the few seconds of an enrollment. gate.ps1 adds one line, the
# browser opens https://admin.mehdisafarzade.dev/__dg/unlock?k=<key>, and gate.ps1
# removes the line again.
#   "<host>:<one-time unlock key>" <device token to hand out>;
