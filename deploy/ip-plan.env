# ─────────────────────────────────────────────────────────────────────────────
# Portfolio Docker network: the IP plan (PLAN.md §9.2, DEPLOY.md "IP plan").
# Single source of truth for the compose files (fixed container IPs), the CI-generated
# nginx upstream files, the API's ADMIN_TRUSTED_SOURCES, and
# deploy/checks/verify-api-isolation.sh. Change these only together.
#
# Subnet chosen 2026-09-27 after a read-only `docker network inspect` on the VPS:
#   existing: bridge 172.17.0.0/16, backend 172.18.0.0/16, no custom address pools.
#   10.231.0.0/24 is outside Docker's default pools (172.17-31/16, 192.168/16) and
#   every host route, so an auto-created network can never collide with it.
#
# Created once on the server (Phase 9, with approval):
#   docker network create --driver bridge --subnet 10.231.0.0/24 --gateway 10.231.0.1 portfolio
# ─────────────────────────────────────────────────────────────────────────────

PF_NETWORK=portfolio
PF_SUBNET=10.231.0.0/24
# Host side of the bridge: host nginx (and any host process) appears as this address.
PF_GATEWAY=10.231.0.1

PF_API_BLUE=10.231.0.11
PF_API_GREEN=10.231.0.12
PF_WEB_BLUE=10.231.0.21
PF_WEB_GREEN=10.231.0.22
PF_ADMIN_BLUE=10.231.0.31
PF_ADMIN_GREEN=10.231.0.32

# Every service listens on this port inside its container. NO host ports are published.
PF_CONTAINER_PORT=3000

# Exact peers trusted to send X-Admin-Device / X-Real-IP: host nginx (gateway) + admin
# blue/green. NOT the web containers, NOT the subnet, NOT the backend network.
PF_ADMIN_TRUSTED_SOURCES=10.231.0.1,10.231.0.31,10.231.0.32
